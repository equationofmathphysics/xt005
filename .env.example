# Copy to .env in this workspace. Keep .env untracked.
HOST=127.0.0.1
PORT=51437

# Proxy variables are inherited by child processes.
# Explicit values win; otherwise run.sh reads GNOME's manual system proxy and
# falls back to HTTP/HTTPS on 1081 plus SOCKS5 on 1080.
# HTTPS_PROXY=http://127.0.0.1:1081
# HTTP_PROXY=http://127.0.0.1:1081
# ALL_PROXY=socks5h://127.0.0.1:1080

# Optional overrides:
# DEFAULT_WORKSPACE=/absolute/path/to/workspace
# WORKSPACES_FILE=/absolute/path/to/state/workspaces.json
# CODEX_HISTORY_FILE=/absolute/path/to/state/codex_history.json
# CODEX_HOME=/absolute/path/to/.codex
# CODEX_COMMAND=/absolute/path/to/codex
